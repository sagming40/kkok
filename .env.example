# .env의 견본 파일 이 파일을 복사하여 .env 파일을 만들고 진짜 값을 채워 넣는다.
# ex) cp .env.example .env (PowerShell: Copy-Item .env.example .env)

# ─── PostgreSQL 컨테이너 설정 (docker compose가 읽음) ───
# 창고(DB) 주인 이름, 창고 비밀번호, 창고 이름
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ─── BACKEND ───
# BACKEND가 DB를 찾아가는 주소 (async 드라이버 asyncpg 사용)
# 형식: postgresql+asyncpg://사용자:비밀번호@localhost:5433/DB이름
DATABASE_URL=
# 짧은 주소 앞부분 (개발: http://localhost:8000)
BASE_URL=
# JWT 도장을 찍을 때 사용하는 보안 잉크. 길고 무작위일수록 안전함
JWT_SECRET=
# cookie를 HTTPS에서만 보낼지 (개발 false / 운영 true)
COOKIE_SECURE=

# ─── 추후 입력 예정 ───
# Redis(책상 위 메모지) 주소
REDIS_URL=
# GitHub 로그인 앱 정보
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
